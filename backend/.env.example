# ── LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Pinecone ──────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=jamiiz-ai-demos

# ── Namespaces (one index, three namespaces) ──────────────────────────
PINECONE_NS_WEBSITE=jamiiz-website
PINECONE_NS_PROPERTY=property-demo
PINECONE_NS_DOCUMENT=document-demo

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── LangSmith (optional but recommended) ─────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=jamiiz-ai-demos
